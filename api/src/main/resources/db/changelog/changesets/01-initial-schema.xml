<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="antigravity">
        <createTable tableName="ponds">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="area" type="DOUBLE"/>
            <column name="depth" type="DOUBLE"/>
            <column name="type" type="VARCHAR(50)"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="current_batch_id" type="VARCHAR(36)"/>
        </createTable>

        <createTable tableName="batches">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pond_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="stocking_date" type="DATE"/>
            <column name="estimated_harvest_date" type="DATE"/>
            <column name="species" type="VARCHAR(100)"/>
            <column name="initial_quantity" type="INTEGER"/>
            <column name="seed_size" type="DOUBLE"/>
            <column name="status" type="VARCHAR(50)"/>
        </createTable>

        <createTable tableName="employees">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="role" type="VARCHAR(100)"/>
            <column name="salary" type="DOUBLE"/>
            <column name="advance_taken" type="DOUBLE"/>
            <column name="status" type="VARCHAR(50)"/>
            <column name="joined_date" type="DATE"/>
        </createTable>

        <createTable tableName="expenditures">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="batch_id" type="VARCHAR(36)"/>
            <column name="date" type="DATE"/>
            <column name="category" type="VARCHAR(100)"/>
            <column name="macro_investment" type="VARCHAR(100)"/>
            <column name="sub_type" type="VARCHAR(100)"/>
            <column name="amount" type="DOUBLE"/>
            <column name="description" type="VARCHAR(1000)"/>
        </createTable>

        <createTable tableName="fish_seeds">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="batch_id" type="VARCHAR(36)"/>
            <column name="date" type="DATE"/>
            <column name="type" type="VARCHAR(100)"/>
            <column name="quantity" type="INTEGER"/>
            <column name="size_inches" type="DOUBLE"/>
            <column name="size_grams" type="DOUBLE"/>
            <column name="unit_price" type="DOUBLE"/>
            <column name="vendor" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="harvest_logs">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="batch_id" type="VARCHAR(36)"/>
            <column name="pond_id" type="VARCHAR(36)"/>
            <column name="date" type="DATE"/>
            <column name="biomass_weight" type="DOUBLE"/>
            <column name="count" type="INTEGER"/>
            <column name="avg_weight_grams" type="DOUBLE"/>
            <column name="basic_rate" type="DOUBLE"/>
            <column name="final_rate" type="DOUBLE"/>
            <column name="discount_weight" type="DOUBLE"/>
            <column name="actual_weight" type="DOUBLE"/>
            <column name="commission" type="DOUBLE"/>
            <column name="revenue" type="DOUBLE"/>
            <column name="buyer" type="VARCHAR(255)"/>
            <column name="is_final" type="BOOLEAN"/>
        </createTable>

        <createTable tableName="feed_logs">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="batch_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="feed_type" type="VARCHAR(100)"/>
            <column name="amount" type="DOUBLE"/>
            <column name="time" type="VARCHAR(10)"/>
        </createTable>

        <createTable tableName="sample_logs">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="batch_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="sample_count" type="INTEGER"/>
            <column name="total_sample_weight" type="DOUBLE"/>
            <column name="average_weight" type="DOUBLE"/>
            <column name="average_length" type="DOUBLE"/>
            <column name="survival_estimate" type="DOUBLE"/>
            <column name="do_level" type="DOUBLE"/>
            <column name="ph_level" type="DOUBLE"/>
            <column name="temperature" type="DOUBLE"/>
            <column name="ammonia" type="DOUBLE"/>
            <column name="salinity" type="DOUBLE"/>
            <column name="turbidity" type="DOUBLE"/>
        </createTable>

        <createTable tableName="salary_payments">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employee_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="date" type="DATE"/>
            <column name="base_salary" type="DOUBLE"/>
            <column name="advance_deduction" type="DOUBLE"/>
            <column name="bonus" type="DOUBLE"/>
            <column name="net_amount" type="DOUBLE"/>
            <column name="month" type="VARCHAR(20)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
