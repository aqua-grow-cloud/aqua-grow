<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="22-add-cultivation-type-column" author="system">
        <addColumn tableName="fish_types">
            <column name="cultivation_type" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="22-add-cultivation-type-constraint" author="system">
        <sql>
            ALTER TABLE fish_types ADD CONSTRAINT chk_cultivation_type 
            CHECK (cultivation_type IN ('FISH', 'SHRIMP', 'OTHER'))
        </sql>
        <rollback>
            ALTER TABLE fish_types DROP CONSTRAINT chk_cultivation_type
        </rollback>
    </changeSet>

</databaseChangeLog>
